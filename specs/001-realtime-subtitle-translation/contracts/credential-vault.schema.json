{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sublingo.local/schemas/credential-vault-envelope.json",
  "title": "SubLingo Encrypted Credential Vault Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "vaultId",
    "revision",
    "algorithm",
    "nonceB64",
    "ciphertextAndTagB64",
    "entries"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "vaultId": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "algorithm": { "const": "A256GCM" },
    "nonceB64": {
      "type": "string",
      "description": "Base64 encoding of exactly 12 random bytes."
    },
    "ciphertextAndTagB64": { "type": "string", "minLength": 24 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profileId", "secretRevision", "fieldNames"],
        "properties": {
          "profileId": { "type": "string", "format": "uuid" },
          "secretRevision": { "type": "integer", "minimum": 1 },
          "fieldNames": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
